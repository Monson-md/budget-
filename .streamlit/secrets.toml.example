# Copie ce fichier vers .streamlit/secrets.toml puis remplace les valeurs
# bidons ci-dessous par le contenu de ta vraie clé de service Firebase
# (Console Firebase > Paramètres du projet > Comptes de service > Générer une
# nouvelle clé privée). Ne commite JAMAIS le fichier secrets.toml réel.

[firebase]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-project-id.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-service-account%40your-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# Configuration SMTP pour l'envoi automatique du code de réinitialisation de
# mot de passe. Optionnel : si cette section [smtp] est absente (ou
# incomplète), l'app retombe proprement sur le flux manuel existant
# (récupération du code dans la console Firestore par l'administrateur).
[smtp]
host = "smtp.example.com"
port = 587
username = "your-smtp-username"
password = "your-smtp-password"
sender = "noreply@example.com"
use_tls = true
